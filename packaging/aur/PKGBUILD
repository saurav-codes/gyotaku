# Maintainer: Yash Bavadiya <krbavadiya11@gmail.com>
#
# The prebuilt release, as published on GitHub. update.sh moves this to a
# new version and fills in the checksums from the release.

pkgname=gyotaku-bin
pkgver=0.1.3
pkgrel=1
pkgdesc="Search your screenshots by the text in them"
arch=('x86_64' 'aarch64')
url="https://github.com/xevrion/gyotaku"
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11')
optdepends=(
    'vulkan-icd-loader: draw the window on the GPU'
    'libglvnd: draw through EGL where there is no Vulkan'
    'wayland: open the window on Wayland'
    'wl-clipboard: copy images on Wayland'
)
provides=('gyotaku')
conflicts=('gyotaku')
options=('!strip' '!debug')
source_x86_64=("gyotaku-$pkgver-x86_64-linux.tar.gz::$url/releases/download/v$pkgver/gyotaku-x86_64-linux.tar.gz")
source_aarch64=("gyotaku-$pkgver-aarch64-linux.tar.gz::$url/releases/download/v$pkgver/gyotaku-aarch64-linux.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    cd "gyotaku-$CARCH-linux"
    install -Dm755 gyotaku gyotaku-app -t "$pkgdir/usr/bin/"
    install -Dm644 share/applications/dev.xevrion.gyotaku.desktop -t "$pkgdir/usr/share/applications/"
    install -Dm644 share/metainfo/dev.xevrion.gyotaku.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
    for icon in share/icons/hicolor/*/apps/*; do
        install -Dm644 "$icon" "$pkgdir/usr/$icon"
    done
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
